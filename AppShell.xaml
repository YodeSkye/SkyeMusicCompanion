<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SkyeMusicCompanion.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SkyeMusicCompanion"
    Title="SkyeMusicCompanion"
    Shell.FlyoutBehavior="Flyout">

    <!-- Flyout Header Card -->
    <Shell.FlyoutHeader>
        <Border Margin="12,12,12,6"
                Padding="16"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Skye Music Companion"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                <Label x:Name="VersionLabel"
                       Text="Version 1.0.0"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
            </VerticalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <!-- Home -->
    <FlyoutItem Title="Home" Route="MainPage" Icon="app.png">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <!-- Reconnect -->
    <FlyoutItem
        x:Name="ReconnectItem"
        Title="Reconnect"
        Route="ReconnectRoute"
        Icon="reconnect.png"
        IsVisible="False">
        <ShellContent>
            <ContentPage />
        </ShellContent>
    </FlyoutItem>

    <!-- Playlist -->
    <FlyoutItem Title="Playlist" Route="PlaylistPage" Icon="playlist.png">
        <ShellContent ContentTemplate="{DataTemplate local:PlaylistPage}" />
    </FlyoutItem>

    <!-- View Log -->
    <FlyoutItem Title="View Log" Route="LogPage" Icon="log.png">
        <ShellContent ContentTemplate="{DataTemplate local:LogPage}" />
    </FlyoutItem>

    <!-- Settings -->
    <FlyoutItem Title="Settings" Route="SettingsPage" Icon="settings.png">
        <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" />
    </FlyoutItem>

</Shell>